#compdef vml

autoload -U is-at-least

(( $+functions[_vml_vm_names_all] )) ||
_vml_vm_names_all() {
    local -a vms expl

    vms=("${(@f)$(_call_program vms vml ls -a 2>/dev/null)}")
    vms=("${(@u)vms:#}")

    _wanted vms expl "virtual machine" compadd "$@" "${expl[@]}" -a vms
}

(( $+functions[_vml_vm_names_running] )) ||
_vml_vm_names_running() {
    local -a vms expl

    vms=("${(@f)$(_call_program vms vml ls -r 2>/dev/null)}")
    vms=("${(@u)vms:#}")

    _wanted vms expl "running virtual machine" compadd "$@" "${expl[@]}" -a vms
}

(( $+functions[_vml_vm_names_stopped] )) ||
_vml_vm_names_stopped() {
    local -a vms expl

    vms=("${(@f)$(_call_program vms vml ls -s 2>/dev/null)}")
    vms=("${(@u)vms:#}")

    _wanted vms expl "stopped virtual machine" compadd "$@" "${expl[@]}" -a vms
}

(( $+functions[_vml_image_names_available] )) ||
_vml_image_names_available() {
    local line
    local -a images expl

    for line in "${(@f)$(_call_program images vml image available 2>/dev/null)}"; do
        images+=("${line%%[[:space:]]*}")
    done
    images=("${(@u)images:#}")

    _wanted images expl "available image" compadd "$@" "${expl[@]}" -a images
}

(( $+functions[_vml_image_names_stored] )) ||
_vml_image_names_stored() {
    local -a images expl

    images=("${(@f)$(_call_program images vml image list 2>/dev/null)}")
    images=("${(@u)images:#}")

    _wanted images expl "stored image" compadd "$@" "${expl[@]}" -a images
}

(( $+functions[_vml_image_names_all] )) ||
_vml_image_names_all() {
    local line
    local -a images expl

    images=("${(@f)$(_call_program images vml image list 2>/dev/null)}")
    for line in "${(@f)$(_call_program images vml image available 2>/dev/null)}"; do
        images+=("${line%%[[:space:]]*}")
    done
    images=("${(@u)images:#}")

    _wanted images expl "image" compadd "$@" "${expl[@]}" -a images
}

_vml() {
    typeset -A opt_args
    typeset -a _arguments_options
