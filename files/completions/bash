_vml_vm_names_all() {
    vml ls -u -a 2>/dev/null
}

_vml_vm_names_running() {
    vml ls -u -r 2>/dev/null
}

_vml_vm_names_stopped() {
    vml ls -u -s 2>/dev/null
}

_vml_image_names_available() {
    local name

    while read -r name _; do
        [[ -n ${name} ]] && printf '%s\n' "${name}"
    done < <(vml image available 2>/dev/null)
}

_vml_image_names_stored() {
    vml image list 2>/dev/null
}

_vml_image_names_all() {
    {
        _vml_image_names_stored
        _vml_image_names_available
    } | awk 'NF && !seen[$0]++'
}

